#!/bin/zsh
# ocmux-open <alias> — open a server pane and tag it so ocmux-refresh can replay it.
#
# Runs in the pane's LOCAL shell (before ssh takes over), so CMUX_SURFACE_ID is
# still the identity of this surface. The tag is stored as cmux's own per-surface
# resume binding, which survives until the surface is closed.
emulate -L zsh
set -u

if (( $# != 1 )); then
  print -u2 "usage: ocmux-open <alias>"
  exit 2
fi
alias_name=$1

# The tag is stored, and later replayed, as the single string
# "ocmux-open <alias>" — `ocmux-refresh` splits it back on that prefix. Anything
# with whitespace or shell metacharacters would not survive that round trip
# (and would be re-expanded by the `zsh -ic` below), so reject it here rather
# than silently truncate.
if [[ ! $alias_name =~ '^[A-Za-z0-9][A-Za-z0-9._-]*$' ]]; then
  print -u2 "ocmux-open: invalid alias '${alias_name}' (expected [A-Za-z0-9][A-Za-z0-9._-]*)"
  exit 2
fi

cmux=${CMUX_BUNDLED_CLI_PATH:-cmux}

if [[ -n ${CMUX_SURFACE_ID:-} ]]; then
  # Tag this surface. `ocmux-refresh` replays exactly this command, so the tag
  # is self-reproducing across any number of refreshes. --workspace is passed
  # so the surface resolves even when the pane's workspace is not the selected
  # one; CMUX_WORKSPACE_ID is this pane's own workspace.
  resume_args=(surface resume set --surface "$CMUX_SURFACE_ID" --shell "ocmux-open ${alias_name}")
  if [[ -n ${CMUX_WORKSPACE_ID:-} ]]; then
    resume_args+=(--workspace "$CMUX_WORKSPACE_ID")
  fi
  "$cmux" "${resume_args[@]}" >/dev/null 2>&1 \
    || print -u2 "ocmux-open: warning: could not tag surface (refresh-all will skip this pane)"
fi

# Hand the pane to the alias. `-i` so ~/.zshrc aliases/functions resolve.
#
# Deliberately NOT `exec`: the pane must outlive the alias. When the ssh behind
# the alias dies, cmux's child-exit policy closes any surface whose root process
# exits after more than ~250ms of runtime (TerminalChildExitPolicy), so an
# exec'd alias takes the whole pane down with it — and a closed surface carries
# no resume binding, so the ⟳ refresh controls have nothing left to respawn.
#
# That matters most for a *refreshed* pane. A pane opened from the "+" menu gets
# the alias typed into an interactive shell (CmuxConfigExecutor sends it as
# initialInput), so a shell already sits underneath and the drop is survivable.
# A refreshed pane instead runs `ocmux-open <alias>` as its root process, so
# without the fallback shell below the first dropped connection would be the
# last one refresh could repair.
zsh -ic "${alias_name}"
exec ${SHELL:-/bin/zsh} -l
